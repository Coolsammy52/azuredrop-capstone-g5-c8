# Copy to .env (never commit .env) and fill in real values.

PORT=3000

# PostgreSQL - either a single URL ...
DATABASE_URL=postgres://azuredrop_user:change-me@localhost:5432/azuredrop
# ... or leave DATABASE_URL empty and use PGHOST / PGPORT / PGUSER / PGPASSWORD / PGDATABASE.
# Set to "true" if your Azure PostgreSQL server requires SSL.
PGSSL=false

# Must be the same secret the auth module uses to sign JWTs.
JWT_SECRET=change-me

# Azure Blob Storage (used only to sign short-lived read links for shared files).
# Preferred on the VM - Managed Identity (no secret needed):
AZURE_STORAGE_ACCOUNT_NAME=
# Local dev alternative (contains an account key - keep out of git):
AZURE_STORAGE_CONNECTION_STRING=
# If both are empty, the share endpoint returns file_url unchanged (local dev only).

# Share link limits (minutes)
SHARE_DEFAULT_EXPIRY_MINUTES=60
SHARE_MAX_EXPIRY_MINUTES=10080
