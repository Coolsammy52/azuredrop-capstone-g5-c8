# Copy to .env (never commit .env) and fill in real values.

PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=azuredrop_user
DB_PASSWORD=change-me
DB_NAME=azuredrop

# Secret used to sign and verify login tokens (JWT)
JWT_SECRET=change-me

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=

# Share links (optional). Preferred on the VM: Managed Identity, which signs short
# download links without a key. Set the account name to turn it on.
AZURE_STORAGE_ACCOUNT_NAME=

# Forgot password email (optional). If SMTP_HOST is empty the reset link is printed
# in the server console instead (local testing only).
FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Share link limits in minutes (defaults: 60 and 10080)
SHARE_DEFAULT_EXPIRY_MINUTES=60
SHARE_MAX_EXPIRY_MINUTES=10080
